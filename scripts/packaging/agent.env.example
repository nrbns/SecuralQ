# SecuraIQ Agent — local config (never commit real tokens)
#
# Preferred commercial flow:
#   1. Dashboard → Agents → Generate bootstrap token (short-lived)
#   2. Download OS package; installer POSTs /api/agents/enroll-by-token
#   3. Agent receives permanent agent_id.agent_key; discard bootstrap token
#   4. Periodic POST /api/licenses/validate — cache result locally (state only)
#
# Local activation cache paths (NOT cryptographic source of truth):
#   Windows: HKLM\Software\SecuraIQ\ (LicenseId, ActivationStatus, LastValidation, ...)
#   Linux:   /etc/securaiq/license.json
#   macOS:   /Library/Application Support/SecuraIQ/license.json
# Never store LICENSE_ED25519_PRIVATE_KEY or signing secrets on the endpoint.
#
# Lab alternative: UI Enroll new agent → copy agent_id.agent_key once into SECURAIQ_TOKEN.

# SecuraIQ server base URL (no trailing slash required)
SECURAIQ_SERVER=http://127.0.0.1:8080

# Permanent agent token after enrollment: <agent_id>.<agent_key>
# (Bootstrap enroll tokens start with enr_ and must not be stored here long-term.)
SECURAIQ_TOKEN=

# Optional: set to 1 only for lab self-signed TLS certs
# SECURAIQ_INSECURE=0

# Optional mTLS client certificate (present to terminating proxy on HTTPS)
# After Agents → Device certificate → Issue/Rotate, save the PEM once:
#   agent.crt + agent.key next to this file, OR:
# SECURAIQ_CLIENT_CERT=
# SECURAIQ_CLIENT_KEY=

# Optional: verify sealed commands from the control plane (RT-17)
# SECURAIQ_AGENT_SIGNING_KEY=           # same HMAC key as server
# SECURAIQ_AGENT_ED25519_PUBLIC_KEY=    # prefer pin over TOFU signing_public_key on commands
# SECURAIQ_REQUIRE_COMMAND_VERIFY=0     # 1 = refuse unsigned/invalid/expired (also auto when server stamps require_verify)
#
# Agent always sends X-SecuraIQ-Ts / Nonce / Sig on check-in, ack, and command result.
# Enable AGENT_REQUIRE_REPLAY_PROTECTION=true on the server for production labs.
