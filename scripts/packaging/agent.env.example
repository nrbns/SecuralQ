# SecuraIQ Agent — local config (never commit real tokens)
#
# 1. In the SecuraIQ UI: Security Operations → Agents → Enroll new agent
#    (or POST /api/agents/enroll with a user JWT). Copy the one-time token.
# 2. Rename this file to agent.env next to the agent binary/script.
# 3. Fill in the values below, then start the agent.

# SecuraIQ server base URL (no trailing slash required)
SECURAIQ_SERVER=http://127.0.0.1:8080

# One-time enrollment token: <agent_id>.<agent_key>
SECURAIQ_TOKEN=

# Optional: set to 1 only for lab self-signed TLS certs
# SECURAIQ_INSECURE=0

# Optional: verify sealed commands from the control plane (RT-17)
# SECURAIQ_AGENT_SIGNING_KEY=           # same HMAC key as server
# SECURAIQ_AGENT_ED25519_PUBLIC_KEY=    # prefer pin over TOFU signing_public_key on commands
# SECURAIQ_REQUIRE_COMMAND_VERIFY=0     # 1 = refuse unsigned/invalid/expired (also auto when server stamps require_verify)
#
# Agent always sends X-SecuraIQ-Ts / Nonce / Sig on check-in, ack, and command result.
# Enable AGENT_REQUIRE_REPLAY_PROTECTION=true on the server for production labs.
