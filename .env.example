# Backends:
# - ollama: local Ollama server
# - openai_compat: LM Studio or other OpenAI-compatible local server
# - hermes: Nous Hermes Agent (OpenAI-compatible API via hermes gateway)
# - unsloth: Unsloth FastLanguageModel (train + infer) — https://github.com/unslothai/unsloth
# - huggingface: direct local Transformers inference
#
# Recommended Ollama models (pull with: ollama pull <name>)
# llama3       - General security methodology
# llama3.1     - Better instructions
# mistral      - Fast default
# codellama    - Code/exploit scripting
# deepseek-coder:6.7b - CTF scripting

MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_MODEL=local-model
OPENAI_COMPAT_API_KEY=lm-studio

# AI Router — intent lanes (code/compliance/intel/report) + optional cloud providers
# Docs: docs/ai-router.md — without keys, router still classifies and stays on local backend
ROUTER_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
# Optional Ollama coder override for code-lane when MODEL_BACKEND=ollama
# OLLAMA_CODER_MODEL=qwen2.5-coder:7b
# Lane model overrides (used when corresponding cloud key is set)
# ROUTER_CODE_MODEL=qwen/qwen2.5-coder-32b-instruct
# ROUTER_COMPLIANCE_MODEL=gpt-4o-mini
# ROUTER_REPORT_MODEL=gpt-4o-mini
# ROUTER_INTEL_MODEL=llama-3.3-70b-versatile
# ROUTER_CLOUD_MODEL=openai/gpt-4o-mini

# Hermes Agent — https://github.com/NousResearch/hermes-agent
# Enable API server in Hermes: API_SERVER_ENABLED=true + matching API_SERVER_KEY
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_MODEL=hermes-agent
HERMES_API_KEY=change-me-local-dev
# Stable memory scope (X-Hermes-Session-Key)
HERMES_SESSION_KEY=
HERMES_SHOW_TOOL_PROGRESS=true

# Hugging Face token (gated models / Unsloth downloads). Also editable in UI Settings.
# One token covers two paths:
#   MODEL_BACKEND=huggingface      → local Transformers (needs torch/transformers/accelerate)
#   MODEL_BACKEND=huggingface_api  → hosted HF Inference Providers, no download
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HUGGINGFACE_API_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Unsloth — https://github.com/unslothai/unsloth
UNSLOTH_MODEL=unsloth/Qwen2.5-0.5B-Instruct-bnb-4bit
UNSLOTH_ADAPTER_DIR=./models/securaiq-unsloth
UNSLOTH_MAX_SEQ_LENGTH=2048
UNSLOTH_LOAD_IN_4BIT=true

# Live web search (faster parallel search; detailed CVE/page context)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SEC=5
# Optional self-hosted SearXNG (preferred when set)
# SEARXNG_URL=http://127.0.0.1:8088

# Network vuln assess (lab/private IPs; public only with UI authorize checkbox)
NET_ASSESS_ENABLED=true
NET_ASSESS_USE_NMAP=true

# Local security tools (builtins always; nmap/nikto/nuclei/… when on PATH)
# Docker image installs nmap + nuclei at build time — see Dockerfile NUCLEI_VERSION
LOCAL_TOOLS_ENABLED=true
LOCAL_TOOLS_AUTO=true
# Heavy scanners (nuclei/nikto/ffuf/gobuster) only when user instructs, unless true:
LOCAL_TOOLS_ALLOW_HEAVY=false

# Optional external ZAP daemon boost (SecuraIQ Web Scanner is built-in without these)
# https://www.zaproxy.org/docs/api/
# Default port 8090 avoids collision with SecuraIQ PORT=8080.
# Example: zap.sh -daemon -port 8090 -config api.key=change-me
ZAP_API_URL=http://127.0.0.1:8090
ZAP_API_KEY=
ZAP_PREFER_API=false

# Bind localhost by default (secure). For phones/tablets/other PCs on Wi-Fi:
#   Windows:  .\start_lan.cmd     or   .\start.cmd -Lan
#   Linux:    bash start_lan.sh   or   ./scripts/start.sh --lan
# (sets HOST=0.0.0.0, CORS_ORIGINS=*, keeps workspace data)
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
# false = empty/fast start (index knowledge via UI Re-index). true = ingest data/knowledge on boot
RAG_AUTO_INGEST=false
# true = empty Mission Control on each lab start (auth off). Scans are archived first (no-loss).
# false = keep live assets/findings across restarts. LAN start scripts set false.
WORKSPACE_ZERO_START=false

# First start: scans work with no model. Chat needs Ollama (if installed) or Settings → API token.
# Optional Qdrant (docker compose --profile vectors up)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=securaiq_knowledge
UPLOAD_MAX_MB=15

# Auth / commercial (off by default for easy local labs)
# DEPLOYMENT_MODE=lab|production — production REQUIRES AUTH_ENABLED=true
# and (by default) DATABASE_URL=postgresql://... (SQLite is lab/community only)
DEPLOYMENT_MODE=lab
# REQUIRE_POSTGRES_IN_PRODUCTION=true
# ALLOW_OPEN_LAN=true only on trusted private networks when auth is off (never public internet)
# start_lan / start -Lan sets this true so phones can open the UI.
ALLOW_OPEN_LAN=false
# Queue a discovery scan of THIS host when LAN-bound so phones auto-load assets.
LAN_AUTO_SCAN=false
AUTH_ENABLED=false
AUTH_ALLOW_REGISTER=false
SESSION_DAYS=14
PASSWORD_RESET_TTL_HOURS=2
BOOTSTRAP_ADMIN_USERNAME=admin
# Required for docker compose — set a strong unique password (no weak default)
BOOTSTRAP_ADMIN_PASSWORD=
# Session cookie (Bearer still works). Production / SaaS compose sets COOKIE_SECURE=true.
# SESSION_COOKIE_NAME=securaiq_session
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_HTTPONLY=true
# FORCE_HTTPS_HEADERS=false
# Secured local login: .\scripts\enable_secure_mode.cmd  then restart
# Password reset (auth on): POST /api/auth/password-reset/request then /confirm
# Tenant header: X-SecuraIQ-Org: <organization_id>
MFA_REQUIRED_FOR_ADMIN=true

# Notifications (in-app always on; email requires SMTP)
NOTIFICATIONS_ENABLED=true
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=securaiq@yourdomain.com
# SMTP_USE_TLS=true

# Jira (optional — create issues from remediations)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SEC

# Threat intel (optional — AbuseIPDB, VT, Shodan, OTX, …)
# Catalog: GET /api/intel/free/catalog · Lookup: GET /api/intel/lookup?q=
# Live without keys: GreyNoise community, OTX indicators, URLScan search, MSRC, FilterLists, NVD, CISA KEV
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
# SHODAN_API_KEY=
# OTX_API_KEY=
# URLSCAN_API_KEY=
# HIBP_API_KEY=
# GREYNOISE_API_KEY=
# PULSEDIVE_API_KEY=
# MALWAREBAZAAR_API_KEY=
# EMAILREP_API_KEY=
# URLHAUS_API_KEY=   # abuse.ch Auth-Key (also used pattern for MalwareBazaar)

# Enterprise auth (beta — see docs/beta-deploy.md)
# MFA_REQUIRED_FOR_ADMIN=false
# OIDC_ENABLED=false
# OIDC_ISSUER=https://keycloak.example/realms/securaiq
# OIDC_CLIENT_ID=securaiq
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8080/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# SCIM_ENABLED=false
# SCIM_TOKEN=   # Bearer token for IdP → GET/POST /scim/v2/Users (beta scaffold)

# Live connectors
# GITHUB_WEBHOOK_SECRET=   # POST /api/integrations/github/webhook
# GITLAB_WEBHOOK_SECRET=   # POST /api/integrations/gitlab/webhook (X-Gitlab-Token)
# TAXII_API_ROOT=          # e.g. https://cti.example/taxii2/root
# TAXII_COLLECTION_ID=
# TAXII_USERNAME=
# TAXII_PASSWORD=
# INGEST_WEBHOOK_SECRET=   # Header X-SecuraIQ-Ingest for POST /api/xdr/ingest + /api/wazuh/webhook
# SLACK_WEBHOOK_URL=      # Incoming Webhook URL — auto-alerts on critical vulns/incidents
# TEAMS_WEBHOOK_URL=      # Incoming Webhook (MessageCard) — same auto-alerts
# SERVICENOW_INSTANCE_URL=https://yourinstance.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# Infra (compose profiles: postgres, redis, saas, debug-ports)
# Lab: leave DATABASE_URL empty (SQLite at DATA_DIR/securaiq.db).
# SaaS / closed-beta: Postgres mandatory — docker compose --profile saas up -d
#   pip install 'psycopg[binary]'
# DATABASE_URL=postgresql://securaiq:YOUR_PASSWORD@postgres:5432/securaiq
# REDIS_URL=redis://redis:6379/0
# Lab Redis Sentinel stub (docker compose --profile redis-ha):
# REDIS_SENTINEL_HOSTS=redis-sentinel:26379
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_PASSWORD=
# Optional: multi-worker SSE fan-out (pub/sub) + durable Redis Streams (XADD).
# Without it, realtime is single-process with an in-memory replay buffer
# (dashboard EventSource + agent gateway share one uvicorn worker).
# REDIS_STREAM_KEY=securaiq:events
# REDIS_STREAM_MAXLEN=10000
# Soft backpressure flag when XLEN >= this (still XADD; maxlen trims)
# REDIS_STREAM_BACKPRESSURE_LEN=8000
# Phase 1 Streams durability (only when REDIS_URL or Sentinel is set; lab without Redis unchanged)
# REDIS_STREAM_DLQ_KEY=securaiq:events:dlq
# REDIS_STREAM_MAX_DELIVERIES=5
# REDIS_STREAM_CLAIM_IDLE_MS=60000
# REALTIME_REPLAY_BUFFER=2000
# Default when Redis is set: Streams fan-out to local SSE (skip pub/sub).
# Set false only if you need transitional Redis pub/sub multi-worker notify.
# REALTIME_STREAMS_FANOUT=true
# Admin DLQ ops: GET/POST /api/admin/realtime/dlq[ /replay|/purge]
# RT-06: prune processed event_id ledger older than N days (default 7)
# EVENT_IDEMPOTENCY_PRUNE_DAYS=7
# Evidence Store TTL for observed claims (host controls / package changes); 0 disables
# EVIDENCE_OBSERVED_TTL_SEC=172800
# When AUTH_ENABLED=true, SSE uses session cookie or ?access_token= (EventSource
# cannot send Authorization headers). Push events are tenant-filtered.
# POSTGRES_PASSWORD=

# Native agent gateway (WebSocket + HTTP check-in fallback)
# AGENT_GATEWAY_ENABLED=true
# AGENT_REQUIRE_REPLAY_PROTECTION=false  # true in production: require X-SecuraIQ-Ts + Nonce (+ Sig when present)
# AGENT_COMMAND_TTL_SEC=86400            # also used as sealed-command expires_at window
# AGENT_COMMAND_ACK_TIMEOUT_SEC=180
# AGENT_REPLAY_MAX_SKEW_SEC=300
# SECURAIQ_AGENT_SIGNING_KEY=  # HMAC for sealed commands; set a long random value in production
# Command seal algorithm: hmac (default) | ed25519 | both
# AGENT_COMMAND_SIGNING_ALG=hmac
# RT-17: when true, gateway refuses unsigned seals and stamps require_verify on commands.
# Default false so labs keep working. Enable in production with a real signing key.
# AGENT_REQUIRE_COMMAND_SIGNATURE=false
# Optional Ed25519 (opt-in via AGENT_COMMAND_SIGNING_ALG=ed25519|both — HMAC remains default):
# SECURAIQ_AGENT_ED25519_PRIVATE_KEY=
# SECURAIQ_AGENT_ED25519_PUBLIC_KEY=
#
# --- Production agent security profile (Commercial Alpha; still NOT mTLS) ---
# When DEPLOYMENT_MODE=production, operators should also set:
#   AUTH_ENABLED=true
#   AGENT_REQUIRE_REPLAY_PROTECTION=true
#   AGENT_REQUIRE_COMMAND_SIGNATURE=true
#   SECURAIQ_AGENT_SIGNING_KEY=<long-random>
#   # Prefer both seals when Ed25519 keys are provisioned:
#   # AGENT_COMMAND_SIGNING_ALG=both
#   # SECURAIQ_AGENT_ED25519_PRIVATE_KEY=...
#   # SECURAIQ_AGENT_ED25519_PUBLIC_KEY=...
# Device certificates / mTLS (RT-16) remain a later Phase 3 milestone.
#
# Packaged agent client (on the monitored host — not this server .env):
#   Copy scripts/packaging/agent.env.example → agent.env next to SecuraIQ-Agent
#   SECURAIQ_SERVER=http://127.0.0.1:8080
#   SECURAIQ_TOKEN=<agent_id>.<agent_key>   # from Settings → Agents → Enroll (shown once)
#   # SECURAIQ_INSECURE=1                   # lab self-signed TLS only
#   # SECURAIQ_AGENT_SIGNING_KEY=           # same HMAC key as server (verify sealed commands)
#   # SECURAIQ_AGENT_ED25519_PUBLIC_KEY=    # prefer pin over TOFU signing_public_key on commands
#   # SECURAIQ_REQUIRE_COMMAND_VERIFY=1     # refuse unsigned/invalid/expired (also auto when server stamps require_verify)
# Build packages: python scripts/build_agent_packages.py  → dist/agent-packages/

# Engagement tool policy: set scope_json on an engagement (API) to a list of
# hosts / IPs / CIDRs. When non-empty, /api/tools/run requires the target in scope.

# Security hardening (restrictive localhost CORS; never use * in production)
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=45

# Secrets encryption at rest (see docs/beta-deploy.md § Secrets encryption)
# ENV_SECRET_ENCRYPTION_KEY=

# Billing / usage metering (soft-gated — off by default so alpha use is never blocked)
BILLING_ENFORCEMENT_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=

# SIEM / security log forwarding — audit events always log locally as JSON either way
SIEM_FORWARD_ENABLED=false
# SIEM_FORWARD_URL=https://your-siem.example/webhook   # or a Splunk HEC endpoint
# SIEM_HEC_TOKEN=
# SIEM_SYSLOG_HOST=
# SIEM_SYSLOG_PORT=514

# Prefect orchestration (optional — local asyncio jobs remain the default)
# pip install "prefect>=3.0,<4"
PREFECT_ENABLED=false
# PREFECT_API_URL=http://127.0.0.1:4200/api

# Wazuh SIEM (manager API JWT + optional Indexer for alert pull)
# WAZUH_BASE_URL=https://wazuh.example:55000
# WAZUH_USER=wazuh-wui
# WAZUH_PASSWORD=
# WAZUH_VERIFY_SSL=false
# WAZUH_SYNC_INTERVAL_SEC=1800
# WAZUH_INDEXER_URL=https://indexer.example:9200
# WAZUH_INDEXER_USER=admin
# WAZUH_INDEXER_PASSWORD=

# Network inventory appliance (cookie session API — password never goes in the URL)
# OPENAUDIT_BASE_URL=http://192.168.56.10
# OPENAUDIT_USER=admin
# OPENAUDIT_PASSWORD=
# OPENAUDIT_API_PREFIX=/open-audit/index.php
# OPENAUDIT_VERIFY_SSL=false
# OPENAUDIT_SYNC_INTERVAL_SEC=3600

# HardeningKitty (Windows CIS / baseline audit — local PowerShell module)
# https://github.com/scipag/HardeningKitty
# Official CIS Benchmarks / CIS-CAT: https://downloads.cisecurity.org/#/
# HARDENINGKITTY_MODULE_PATH=C:\Program Files\WindowsPowerShell\Modules\HardeningKitty\0.9.3
# HARDENINGKITTY_LIST=finding_list_cis_microsoft_windows_11_23H2_1.0.0_machine.csv
# Or: .\scripts\use_hardeningkitty.cmd -Download

# SonarQube / SonarCloud (authorized projects — live issues → Vulnerabilities)
# SONARQUBE_BASE_URL=https://sonar.example.com
# SONARQUBE_TOKEN=squ_...
# SONARQUBE_PROJECT_KEY=my-project
# SONARQUBE_VERIFY_SSL=true
# SONARQUBE_SYNC_INTERVAL_SEC=3600
# SONARQUBE_ISSUE_TYPES=VULNERABILITY,SECURITY_HOTSPOT,BUG
# Or: Import scan with issues JSON export (no token required)

# TheHive case management (authorized IR lab)
# THEHIVE_BASE_URL=https://thehive.lab
# THEHIVE_API_KEY=
# THEHIVE_VERIFY_SSL=false
# THEHIVE_SYNC_INTERVAL_SEC=1800

# Cloud posture (authorized cloud tenants only)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_JSON=C:\secrets\gcp-sa.json
# CLOUD_POSTURE_SYNC_INTERVAL_SEC=3600
# Lab without live cloud: POST /api/cloud/import with findings JSON
# Optional: pip install boto3 google-cloud-securitycenter

# Microsoft Defender for Endpoint + XDR advanced hunting (authorized tenant)
# DEFENDER_TENANT_ID=
# DEFENDER_CLIENT_ID=
# DEFENDER_CLIENT_SECRET=
# DEFENDER_HUNTING_API=auto   # auto | graph | legacy
# Graph permission: ThreatHunting.Read.All  → POST /api/xdr/hunting/run
# Legacy MTP: AdvancedHunting.Read.All (retiring — prefer Graph)
# https://learn.microsoft.com/en-us/graph/api/security-security-runhuntingquery
# https://learn.microsoft.com/en-us/defender-xdr/api-advanced-hunting

# CrowdStrike Falcon (authorized tenant) — polls every XDR_SYNC_INTERVAL_SEC by
# default; also holds open the Falcon Streaming API for real-time push if the
# API client has the "Event streams: Read" scope (falls back to poll-only if not).
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=
# CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com   # EU-1/US-2/US-GOV-1: change host
# CROWDSTRIKE_STREAMING_ENABLED=true

# Sophos Central (authorized tenant) — near-realtime poll (no Falcon-style stream)
# SOPHOS_CLIENT_ID=
# SOPHOS_CLIENT_SECRET=

# SentinelOne (authorized tenant, static API token) — near-realtime poll
# SENTINELONE_API_TOKEN=
# SENTINELONE_BASE_URL=https://your-console.sentinelone.net

# XDR live cadence:
#   - CrowdStrike: Falcon Streaming API when enabled (true push)
#   - Sophos / SentinelOne / Defender: near-realtime poll (default 60s)
#   - All vendors: slow xdr_sync reconciliation + POST /api/xdr/ingest for webhooks
# XDR_NEAR_REALTIME_ENABLED=true
# XDR_NEAR_REALTIME_INTERVAL_SEC=60
# XDR_SYNC_INTERVAL_SEC=1800
